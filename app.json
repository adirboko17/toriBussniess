{
  "expo": {
    "name": "Tori ניהול",
    "slug": "tori-admin",
    "scheme": "tori-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f8f8f6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "il.co.wetori.business",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "he",
        "ITSAppUsesNonExemptEncryption": false,
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": [
          "he"
        ]
      }
    },
    "android": {
      "package": "co.il.wetori.admin",
      "adaptiveIcon": {
        "backgroundColor": "#6bff85",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true,
          "supportedLocales": [
            "he"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f8f8f6",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0f0e0e"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#171616"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "האפליקציה צריכה גישה לתמונות כדי להעלות לוגו, אייקון ומסך פתיחה לעסק.",
          "cameraPermission": "האפליקציה צריכה גישה למצלמה כדי לצלם לוגו או אייקון לעסק.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de0574dd-3c50-43cc-a8bd-4d45b6c6450a"
      }
    },
    "owner": "itaybenyair"
  }
}
